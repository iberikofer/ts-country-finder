{
  "name": "ts-country-finder",
  "version": "2.1.0",
  "description": "Fast and responsive country search application built with TypeScript and REST Countries API",
  "homepage": "https://iberikofer.github.io/ts-country-finder",
  "scripts": {
    "dev": "parcel src/*.html",
    "start": "parcel src/*.html",
    "build": "tsc --noEmit && parcel build src/*.html --public-url /ts-country-finder/",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iberikofer/ts-country-finder.git"
  },
  "keywords": [
    "country-finder",
    "rest-countries-api",
    "typescript",
    "parcel"
  ],
  "author": "iberikofer",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/iberikofer/ts-country-finder/issues"
  },
  "dependencies": {
    "lodash.debounce": "^4.0.8",
    "notiflix": "^3.2.8"
  },
  "devDependencies": {
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^26.6.5",
    "parcel": "^2.12.0",
    "parcel-reporter-clean-dist": "^1.0.4",
    "typescript": "^7.0.2"
  },
  "browserslist": "> 0.5%, last 2 versions, not dead"
}
